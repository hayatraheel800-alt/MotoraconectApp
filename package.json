{
  "name": "motoraconect",
  "private": true,
  "version": "0.1.0",
  "description": "Motoraconect monorepo — BUY. SELL. VERIFY. IMPORT. UNDERSTAND.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "web": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "web:typecheck": "npm run typecheck --workspace=apps/web",
    "admin": "npm run dev --workspace=apps/admin",
    "admin:build": "npm run build --workspace=apps/admin",
    "admin:typecheck": "npm run typecheck --workspace=apps/admin",
    "build": "npm run build --workspace=apps/web"
  },
  "engines": {
    "node": "24.x"
  }
}
