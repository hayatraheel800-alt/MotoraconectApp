# Copy this file to .env and fill in your own Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API
# The anon key is safe to expose in a client app — it is NOT a secret,
# it is bounded by Row Level Security policies in Postgres.
#
# NEVER put the service_role key in this file or anywhere in apps/mobile.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here